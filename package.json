{
  "name": "opencode-peak-guard",
  "version": "0.2.0",
  "description": "opencode TUI plugin: intercept prompt submission during model peak-pricing windows (e.g. DeepSeek x2) and offer to wait until off-peak",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jetsanix/opencode-peak-guard.git"
  },
  "bugs": {
    "url": "https://github.com/jetsanix/opencode-peak-guard/issues"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsgo --noEmit || tsc --noEmit",
    "pack": "npm pack"
  },
  "keywords": [
    "opencode",
    "tui",
    "plugin",
    "deepseek",
    "pricing",
    "peak"
  ],
  "dependencies": {
    "@opentui/core": "^0.5.1"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.11",
    "@opentui/solid": "^0.5.1",
    "solid-js": "^1.9.0",
    "@types/bun": "^1.3.14",
    "typescript": "^5.6.0"
  }
}
